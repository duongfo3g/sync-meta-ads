/** Server-side: nhận list account_id đã chọn từ dialog + chạy sync */
function processCustomSync(accountIds, since, until) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var allAccounts = getAllAdAccounts();
  var selected = allAccounts.filter(function(a) { return accountIds.indexOf(a.id) !== -1; });
  if (selected.length === 0) throw new Error('Không có account nào được chọn');
  logMsg(ss, '▶ Custom Sync: ' + since + ' → ' + until + ' | ' + selected.length + '/' + allAccounts.length + ' accounts');
  _syncAccounts(ss, selected, since, until);
}

/** Xóa duplicate trong sheet Daily — chạy 1 lần để fix data cũ */
function fixDuplicates() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName(CONFIG.SHEET_DAILY);
  if (!sheet || sheet.getLastRow() <= 1) { Logger.log('Sheet trống'); return; }

  var data = sheet.getDataRange().getValues();
  var headers = data[0];

  var dateIdx = headers.indexOf('date');
  var accIdx  = headers.indexOf('account_id');
  var adIdx   = headers.indexOf('ad_id');

  if (dateIdx < 0 || accIdx < 0 || adIdx < 0) { Logger.log('Không tìm thấy key columns'); return; }

  var seen = {};
  var kept = [headers];
  var dupCount = 0;

  for (var r = 1; r < data.length; r++) {
    var key = String(data[r][dateIdx]).trim() + '|'
            + String(data[r][accIdx]).trim() + '|'
            + String(data[r][adIdx]).trim();
    if (seen[key]) { dupCount++; continue; }
    seen[key] = true;
    kept.push(data[r]);
  }

  sheet.clearContents();
  sheet.getRange(1, 1, kept.length, kept[0].length).setValues(kept);
  _formatHeader(sheet);
  _sortByDate(sheet);
  Logger.log('✅ Đã xóa ' + dupCount + ' dòng duplicate. Còn lại: ' + (kept.length - 1) + ' dòng');
}

