function logMsg(ss, msg) {
  console.log(msg);
  var sheet = _getOrCreateSheet(ss, CONFIG.SHEET_LOG);
  sheet.appendRow([new Date(), msg]);
  if (sheet.getLastRow() > 1000) sheet.deleteRow(2);
}

/** Token chỉ lấy từ Script Properties — không hardcode */
function _getToken() {
  var t = PropertiesService.getScriptProperties().getProperty('META_TOKEN');
  if (!t) throw new Error('Chưa set META_TOKEN trong Project Settings → Script Properties');
  return t;
}

function _getBusinessId() {
  return PropertiesService.getScriptProperties().getProperty('META_BUSINESS_ID') || '';
}

function _today() { return _formatDate(new Date()); }

function _daysAgo(n) { var d = new Date(); d.setDate(d.getDate() - n); return d; }

function _formatDate(d) { return Utilities.formatDate(d, CONFIG.TIMEZONE, 'yyyy-MM-dd'); }

// ============================================================
// QUEUE SYNC — mỗi trigger chỉ sync 1 account, tự hẹn trigger account kế tiếp
// ============================================================

const QUEUE = {
  PROP_KEY      : 'META_QUEUE',
  HANDLER       : 'Q_processNext',
  DELAY_MS      : 60 * 1000,      // nghỉ giữa 2 account (after() tối thiểu ~1 phút)
  SAFETY_MS     : 7 * 60 * 1000,  // trigger dự phòng nếu execution bị kill ở 6 phút
  DAILY_HOUR    : 6,              // giờ chạy queue daily tự động
};

/** Khởi động queue Daily (gắn time-driven trigger hằng ngày vào hàm này) */
function startQueueDaily() {
  Q_start_(_formatDate(_daysAgo(CONFIG.LOOKBACK_DAYS)), _today(), 'Daily');
}

/** Khởi động queue Historical */
function startQueueHistorical() {
  Q_start_(CONFIG.HISTORICAL_SINCE, _today(), 'Historical');
}

function Q_start_(since, until, label) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var props = PropertiesService.getScriptProperties();
  if (props.getProperty(QUEUE.PROP_KEY)) {
    logMsg(ss, '⚠️ [Queue] Đang có queue chạy dở — bỏ qua. Dùng "Huỷ queue" nếu muốn chạy lại.');
    return;
  }
  var accounts = getAllAdAccounts();
  var state = {
    label: label, since: since, until: until,
    accounts: accounts, idx: 0, failed: [],
    startedAt: new Date().toISOString()
  };
  props.setProperty(QUEUE.PROP_KEY, JSON.stringify(state));
  logMsg(ss, '▶ [Queue ' + label + '] ' + accounts.length + ' accounts | ' + since + ' → ' + until);
  Q_clearTriggers_();
  Q_scheduleNext_(1000);
}

/** Handler của trigger — mỗi lần chạy xử lý đúng 1 account */
function Q_processNext() {
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(30000)) return; // đã có execution khác giữ lock
  try {
    Q_clearTriggers_();
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var props = PropertiesService.getScriptProperties();
    var raw = props.getProperty(QUEUE.PROP_KEY);
    if (!raw) return;
    var state = JSON.parse(raw);

    // Hết danh sách → kết thúc
    if (state.idx >= state.accounts.length) {
      props.deleteProperty(QUEUE.PROP_KEY);
      logMsg(ss, '🏁 [Queue ' + state.label + '] Hoàn tất ' + state.accounts.length + ' accounts'
        + (state.failed.length ? ' | Bị timeout/lỗi: ' + state.failed.join(', ') : ''));
      return;
    }

    var acc = state.accounts[state.idx];
    var pos = (state.idx + 1) + '/' + state.accounts.length;

    // Tăng idx + hẹn trigger dự phòng TRƯỚC khi sync (phòng bị kill 6 phút)
    state.idx++;
    state.failed.push(acc.name);           // tạm đánh dấu, gỡ ra nếu chạy xong
    props.setProperty(QUEUE.PROP_KEY, JSON.stringify(state));
    Q_scheduleNext_(QUEUE.SAFETY_MS);

    logMsg(ss, '▶ [Queue ' + state.label + '] ' + pos + ': ' + acc.name + ' (' + acc.id + ')');
    try {
      _syncAccounts(ss, [acc], state.since, state.until);
      state.failed.pop();                  // chạy xong → gỡ đánh dấu
    } catch (e) {
      logMsg(ss, '❌ [Queue] ' + acc.name + ': ' + e.message);
    }

    props.setProperty(QUEUE.PROP_KEY, JSON.stringify(state));
    Q_clearTriggers_();                    // xoá trigger dự phòng
    Q_scheduleNext_(QUEUE.DELAY_MS);       // hẹn account kế tiếp
  } finally {
    lock.releaseLock();
  }
}

/** Xem tiến độ queue */
function Q_status() {
  var raw = PropertiesService.getScriptProperties().getProperty(QUEUE.PROP_KEY);
  var msg = raw
    ? (function(s) {
        return 'Queue ' + s.label + ': ' + s.idx + '/' + s.accounts.length + ' accounts\n'
          + s.since + ' → ' + s.until + '\nBắt đầu: ' + s.startedAt
          + (s.idx < s.accounts.length ? '\nKế tiếp: ' + s.accounts[s.idx].name : '');
      })(JSON.parse(raw))
    : 'Không có queue nào đang chạy';
  Logger.log(msg);
  try { SpreadsheetApp.getUi().alert(msg); } catch(e) {}
}

/** Huỷ queue đang chạy */
function Q_cancel() {
  PropertiesService.getScriptProperties().deleteProperty(QUEUE.PROP_KEY);
  Q_clearTriggers_();
  logMsg(SpreadsheetApp.getActiveSpreadsheet(), '🛑 [Queue] Đã huỷ');
}

/** Cài trigger hằng ngày cho startQueueDaily (chạy 1 lần) */
function Q_installDailyTrigger() {
  ScriptApp.getProjectTriggers().forEach(function(t) {
    var fn = t.getHandlerFunction();
    if (fn === 'startQueueDaily' || fn === 'runDailySync') ScriptApp.deleteTrigger(t);
  });
  ScriptApp.newTrigger('startQueueDaily').timeBased()
    .everyDays(1).atHour(QUEUE.DAILY_HOUR).inTimezone(CONFIG.TIMEZONE).create();
  logMsg(SpreadsheetApp.getActiveSpreadsheet(), '✅ [Queue] Đã cài trigger daily lúc ' + QUEUE.DAILY_HOUR + 'h');
}

function Q_scheduleNext_(ms) {
  ScriptApp.newTrigger(QUEUE.HANDLER).timeBased().after(ms).create();
}

function Q_clearTriggers_() {
  ScriptApp.getProjectTriggers().forEach(function(t) {
    if (t.getHandlerFunction() === QUEUE.HANDLER) ScriptApp.deleteTrigger(t);
  });
}
