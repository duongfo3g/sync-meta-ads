// ============================================================
// AD ACCOUNTS — đọc từ sheet "account id" hoặc CONFIG
// ============================================================

function getAllAdAccounts() {
  // Ưu tiên 1: hardcode trong CONFIG
  if (CONFIG.AD_ACCOUNT_IDS.length > 0) {
    return CONFIG.AD_ACCOUNT_IDS.map(function(id) { return { id: 'act_' + id.replace('act_',''), name: id }; });
  }

  // Ưu tiên 2: đọc từ sheet "account id"
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName(CONFIG.SHEET_ACCOUNTS);
  if (sheet && sheet.getLastRow() > 1) {
    var data = sheet.getRange(2, 1, sheet.getLastRow() - 1, Math.max(CONFIG.COL_SYNC_ENABLED, CONFIG.COL_ACCOUNT_NAME)).getValues();
    var accounts = [];
    for (var i = 0; i < data.length; i++) {
      var rawId = String(data[i][CONFIG.COL_ACCOUNT_ID - 1]).trim();
      var name  = String(data[i][CONFIG.COL_ACCOUNT_NAME - 1]).trim() || rawId;
      if (!rawId || rawId === '') continue;
      var enabled = data[i][CONFIG.COL_SYNC_ENABLED - 1];
      if (enabled !== '' && enabled !== true && String(enabled).toUpperCase() !== 'TRUE') continue;
      var id = rawId.indexOf('act_') === 0 ? rawId : 'act_' + rawId;
      accounts.push({ id: id, name: name });
    }
    if (accounts.length > 0) return accounts;
  }

  // Fallback: lấy từ BM
  return _getAccountsFromBM();
}

function _getAccountsFromBM() {
  var bmId = _getBusinessId();
  if (!bmId) throw new Error('Chưa có account trong sheet "' + CONFIG.SHEET_ACCOUNTS + '" và chưa set META_BUSINESS_ID trong Script Properties.');
  var accounts = [];
  var endpoints = ['owned_ad_accounts', 'client_ad_accounts'];
  for (var e = 0; e < endpoints.length; e++) {
    var url = 'https://graph.facebook.com/' + CONFIG.API_VERSION
      + '/' + bmId + '/' + endpoints[e]
      + '?fields=id,name,account_status&limit=100&access_token=' + encodeURIComponent(_getToken());
    var resp = JSON.parse(UrlFetchApp.fetch(url, { muteHttpExceptions: true }).getContentText());
    if (resp.error) { Logger.log('⚠️ ' + endpoints[e] + ': ' + resp.error.message); continue; }
    if (resp.data) {
      var active = resp.data.filter(function(a) { return a.account_status === 1; });
      for (var i = 0; i < active.length; i++) accounts.push({ id: active[i].id, name: active[i].name });
    }
  }
  var seen = {}, deduped = [];
  for (var j = 0; j < accounts.length; j++) {
    if (!seen[accounts[j].id]) { seen[accounts[j].id] = true; deduped.push(accounts[j]); }
  }
  if (deduped.length === 0) throw new Error('Không tìm thấy ad account nào.');
  return deduped;
}

// ============================================================
// CORE — chia từng tháng, catch lỗi từng account
// ============================================================

function _syncAccounts(ss, accounts, since, until) {
  var ok = [];
  var failed = [];
  var chunks = _splitIntoMonths(since, until);

  if (chunks.length > 1) logMsg(ss, 'Chia thành ' + chunks.length + ' tháng');

  for (var i = 0; i < accounts.length; i++) {
    var acc = accounts[i];
    var accRows = 0;
    var accError = null;

    for (var c = 0; c < chunks.length; c++) {
      var attempt = 0;
      var success = false;
      while (attempt < 2 && !success) {
        try {
          var rows = _pullToDaily(ss, acc, chunks[c][0], chunks[c][1]);
          accRows += rows;
          success = true;
          if (chunks.length > 1) Utilities.sleep(500);
        } catch (e) {
          attempt++;
          var parsed = _parseApiError(e.message, acc.id);
          if (attempt < 2 && _isTransientError(e.message)) {
            logMsg(ss, '  ⚠️ ' + acc.name + ' [' + chunks[c][0] + '→' + chunks[c][1] + ']: lỗi tạm thời, thử lại...');
            Utilities.sleep(3000);
            continue;
          }
          accError = parsed;
          logMsg(ss, '  ❌ ' + acc.name + ' [' + chunks[c][0] + '→' + chunks[c][1] + ']: ' + accError);
          break;
        }
      }
      if (accError) break;
    }

    if (!accError) {
      ok.push(acc.name + ' (' + acc.id + '): ' + accRows + ' dòng');
    } else {
      failed.push({ name: acc.name, id: acc.id, reason: accError });
    }

    if (i < accounts.length - 1) Utilities.sleep(1500);
  }

  logMsg(ss, '─────────────────────────────');
  logMsg(ss, '✅ OK: ' + ok.length + '/' + accounts.length + ' accounts');
  for (var j = 0; j < ok.length; j++) logMsg(ss, '   • ' + ok[j]);
  if (failed.length > 0) {
    logMsg(ss, '❌ Lỗi: ' + failed.length + '/' + accounts.length + ' accounts');
    for (var k = 0; k < failed.length; k++) {
      logMsg(ss, '   • ' + failed[k].name + ' (' + failed[k].id + ')');
      logMsg(ss, '     ' + failed[k].reason);
    }
  }
  logMsg(ss, '─────────────────────────────');
}

/** code:1/subcode:99 là lỗi transient phía Meta — retry trước khi báo lỗi thật */
function _isTransientError(msg) {
  return msg.indexOf('code:1|subcode:99') !== -1;
}

function _splitIntoMonths(since, until) {
  var chunks = [];
  var start = new Date(since + 'T00:00:00');
  var end   = new Date(until + 'T00:00:00');
  while (start <= end) {
    var chunkStart = _formatDate(start);
    var lastDay    = new Date(start.getFullYear(), start.getMonth() + 1, 0);
    var chunkEnd   = _formatDate(lastDay < end ? lastDay : end);
    chunks.push([chunkStart, chunkEnd]);
    start = new Date(start.getFullYear(), start.getMonth() + 1, 1);
  }
  return chunks;
}

// ============================================================
// PULL DATA
// ============================================================

function _pullToDaily(ss, acc, since, until) {
  var sheet = _getOrCreateSheet(ss, CONFIG.SHEET_DAILY);
  var token     = _getToken();
  var timeRange = JSON.stringify({ since: since, until: until });
  var url = 'https://graph.facebook.com/' + CONFIG.API_VERSION + '/' + acc.id + '/insights'
    + '?access_token=' + encodeURIComponent(token)
    + '&level=ad'
    + '&fields=' + encodeURIComponent(INSIGHT_FIELDS)
    + '&time_range=' + encodeURIComponent(timeRange)
    + '&time_increment=1'
    + '&limit=500';

  var allData = [];
  var pageCount = 0;

  while (url) {
    var resp = UrlFetchApp.fetch(url, { muteHttpExceptions: true });
    if (resp.getResponseCode() === 429) {
      logMsg(ss, '  ⏳ Rate limit [' + acc.name + '], chờ 60s...');
      Utilities.sleep(60000);
      continue;
    }
    var json = JSON.parse(resp.getContentText());
    if (json.error) {
      throw new Error(
        'META_API_ERROR|code:' + json.error.code
        + '|subcode:' + (json.error.error_subcode || 'none')
        + '|type:' + (json.error.type || 'unknown')
        + '|msg:' + json.error.message
      );
    }
    if (json.data && json.data.length > 0) {
      for (var i = 0; i < json.data.length; i++) allData.push(json.data[i]);
    }
    url = (json.paging && json.paging.next) ? json.paging.next : null;
    pageCount++;
    if (url) Utilities.sleep(300);
  }

  if (allData.length === 0) {
    logMsg(ss, '  ⚠️ ' + acc.name + ' [' + since + '→' + until + ']: không có data');
    return 0;
  }

  var rows = allData.map(function(row) { return _flattenRow(row, acc.id, acc.name); });
  _upsertRows(sheet, rows, ['date', 'account_id', 'ad_id']);
  logMsg(ss, '  ✓ ' + acc.name + ' [' + since + '→' + until + ']: ' + rows.length + ' dòng (' + pageCount + ' pages)');
  return rows.length;
}

// ============================================================
// PARSE LỖI
// ============================================================

function _parseApiError(msg, accId) {
  if (msg.indexOf('META_API_ERROR|') === -1) return msg;
  var code    = (msg.match(/code:(\d+)/)    || [])[1] || '?';
  var subcode = (msg.match(/subcode:(\w+)/) || [])[1] || 'none';
  var detail  = (msg.match(/msg:(.+)/)      || [])[1] || msg;
  var hint = '';
  switch (code) {
    case '1':
      hint = (subcode === '99')
        ? 'Lỗi tạm thời phía Meta (đã retry nhưng vẫn lỗi) — kiểm tra System User đã add vào account chưa, hoặc account có thuộc đúng BM không'
        : 'Account bị restricted hoặc System User chưa được add vào account trong BM';
      break;
    case '2':   hint = 'Service tạm thời không khả dụng — thử lại sau'; break;
    case '4':   hint = 'App rate limit — chờ 1 tiếng rồi chạy lại'; break;
    case '10':  hint = 'Permission denied — token thiếu ads_read hoặc ads_management'; break;
    case '17':  hint = 'User request limit — chạy lại sau 10 phút'; break;
    case '100': hint = 'Invalid parameter — kiểm tra account ID format act_XXXXX'; break;
    case '190': hint = 'Token hết hạn — cập nhật META_TOKEN trong Script Properties'; break;
    case '200': hint = 'API access blocked — app ở Development mode hoặc chưa pass App Review'; break;
    case '273': hint = 'Account không thuộc BM hoặc không đủ quyền'; break;
    default:    hint = 'Xem: https://developers.facebook.com/docs/graph-api/guides/error-handling';
  }
  return '[code:' + code + (subcode !== 'none' ? '/sub:' + subcode : '') + '] ' + detail + ' → ' + hint;
}

// ============================================================
// DATA FLATTEN
// ============================================================

function _flattenRow(row, accountId, accountName) {
  var flat = {};
  flat['date']         = String(row['date_start'] || '').trim();
  flat['account_id']   = String(accountId || '').trim();
  flat['account_name'] = String(accountName || '').trim();

  var scalars = [
    'campaign_id','campaign_name','adset_id','adset_name','ad_id','ad_name',
    'spend','reach','frequency','impressions',
    'clicks','unique_clicks','inline_link_clicks','unique_inline_link_clicks',
    'ctr','unique_ctr','inline_link_click_ctr','cpm','cpp','cpc','cost_per_unique_click',
    'estimated_ad_recall_rate','estimated_ad_recallers',
    'quality_ranking','engagement_rate_ranking','conversion_rate_ranking',
    'canvas_avg_view_time','canvas_avg_view_percent',
  ];
  for (var i = 0; i < scalars.length; i++) {
    var v = row[scalars[i]];
    flat[scalars[i]] = (v !== undefined && v !== null) ? String(v).trim() : '';
  }

  flat['video_view']             = _firstVal(row.video_play_actions);
  flat['video_p25']              = _firstVal(row.video_p25_watched_actions);
  flat['video_p50']              = _firstVal(row.video_p50_watched_actions);
  flat['video_p75']              = _firstVal(row.video_p75_watched_actions);
  flat['video_p100']             = _firstVal(row.video_p100_watched_actions);
  flat['video_thruplay']         = _firstVal(row.video_thruplay_watched_actions);
  flat['video_avg_time']         = _firstVal(row.video_avg_time_watched_actions);
  flat['outbound_clicks']        = _findAction(row.outbound_clicks, 'outbound_click');
  flat['unique_outbound_clicks'] = _findAction(row.unique_outbound_clicks, 'outbound_click');
  flat['website_purchase_roas']  = _findAction(row.website_purchase_roas, 'offsite_conversion.fb_pixel_purchase');

  var actionArrays = { actions: row.actions, action_values: row.action_values, cost_per_action: row.cost_per_action_type, unique_actions: row.unique_actions };
  var allTypes = {};
  var keys = Object.keys(actionArrays);
  for (var k = 0; k < keys.length; k++) {
    var arr = actionArrays[keys[k]];
    if (Array.isArray(arr)) for (var j = 0; j < arr.length; j++) allTypes[arr[j].action_type] = true;
  }
  var types = Object.keys(allTypes);
  for (var t = 0; t < types.length; t++) {
    var type = types[t], col = type.replace(/\./g, '_');
    flat['action_' + col] = _findAction(row.actions, type);
    flat['value_' + col]  = _findAction(row.action_values, type);
    flat['cost_' + col]   = _findAction(row.cost_per_action_type, type);
    flat['unique_' + col] = _findAction(row.unique_actions, type);
  }
  return flat;
}

function _findAction(arr, type) {
  if (!Array.isArray(arr)) return '';
  for (var i = 0; i < arr.length; i++) if (arr[i].action_type === type) return arr[i].value !== undefined ? arr[i].value : '';
  return '';
}

function _firstVal(arr) {
  if (!Array.isArray(arr) || arr.length === 0) return '';
  return arr[0].value !== undefined ? arr[0].value : '';
}

// ============================================================
// SHEET HELPERS
// ============================================================

function _getOrCreateSheet(ss, name) {
  return ss.getSheetByName(name) || ss.insertSheet(name);
}

function _upsertRows(sheet, newRows, keyColumns) {
  if (newRows.length === 0) return;
  var newKeySet = {};
  for (var i = 0; i < newRows.length; i++) newKeySet[_buildKey(newRows[i], keyColumns)] = true;
  var allHeaders = _mergeHeaders(sheet, newRows);
  if (sheet.getLastRow() === 0) { _writeAll(sheet, allHeaders, newRows); return; }
  var existingData    = sheet.getDataRange().getValues();
  var existingDisplay = sheet.getDataRange().getDisplayValues(); // dùng để build key — tránh float conversion
  var oldHeaders = existingData[0].map(function(h) { return String(h).trim(); });
  var kept = [];
  for (var r = 1; r < existingData.length; r++) {
    var keyObj = {};
    for (var c = 0; c < oldHeaders.length; c++) if (oldHeaders[c]) keyObj[oldHeaders[c]] = String(existingDisplay[r][c]).trim();
    if (newKeySet[_buildKey(keyObj, keyColumns)]) continue;
    var obj = {};
    for (var c = 0; c < oldHeaders.length; c++) if (oldHeaders[c]) obj[oldHeaders[c]] = existingData[r][c];
    kept.push(obj);
  }
  var finalData = [allHeaders];
  for (var k = 0; k < kept.length; k++) finalData.push(allHeaders.map(function(h) { return kept[k][h] !== undefined ? kept[k][h] : ''; }));
  for (var n = 0; n < newRows.length; n++) finalData.push(allHeaders.map(function(h) { return newRows[n][h] !== undefined ? newRows[n][h] : ''; }));
  _setIdColumnsTextFormat(sheet, allHeaders, finalData.length);
  sheet.clearContents();
  sheet.getRange(1, 1, finalData.length, finalData[0].length).setValues(finalData);
  _formatHeader(sheet);
  _sortByDate(sheet);
}

function _writeAll(sheet, headers, rows) {
  var data = [headers];
  for (var i = 0; i < rows.length; i++) data.push(headers.map(function(h) { return rows[i][h] !== undefined ? rows[i][h] : ''; }));
  _setIdColumnsTextFormat(sheet, headers, data.length);
  sheet.getRange(1, 1, data.length, data[0].length).setValues(data);
  _formatHeader(sheet);
  _sortByDate(sheet);
}

/** Sort cột date (cột 1) descending — dữ liệu mới nhất lên đầu */
function _sortByDate(sheet) {
  if (sheet.getLastRow() <= 2) return;
  var dataRange = sheet.getRange(2, 1, sheet.getLastRow() - 1, sheet.getLastColumn());
  dataRange.sort({ column: 1, ascending: false });
}

function _mergeHeaders(sheet, rows) {
  var seen = {}, result = [];
  for (var f = 0; f < FIXED_HEADERS.length; f++) { seen[FIXED_HEADERS[f]] = true; result.push(FIXED_HEADERS[f]); }
  if (sheet.getLastRow() > 0) {
    var ex = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
    for (var i = 0; i < ex.length; i++) { var h = String(ex[i]).trim(); if (h && !seen[h]) { seen[h] = true; result.push(h); } }
  }
  for (var r = 0; r < rows.length; r++) {
    var keys = Object.keys(rows[r]);
    for (var k = 0; k < keys.length; k++) if (!seen[keys[k]]) { seen[keys[k]] = true; result.push(keys[k]); }
  }
  return result;
}

function _buildKey(obj, cols) {
  return cols.map(function(c) { return String(obj[c] !== undefined ? obj[c] : '').trim(); }).join('|');
}

/** Format cột ID số lớn về Plain Text TRƯỚC khi ghi — tránh Sheets convert float mất precision */
function _setIdColumnsTextFormat(sheet, headers, totalRows) {
  if (totalRows <= 1) return;
  var idCols = ['ad_id', 'adset_id', 'campaign_id', 'account_id'];
  for (var i = 0; i < headers.length; i++) {
    if (idCols.indexOf(String(headers[i]).trim()) >= 0) {
      sheet.getRange(2, i + 1, totalRows - 1, 1).setNumberFormat('@STRING@');
    }
  }
}

function _formatHeader(sheet) {
  if (sheet.getLastColumn() === 0) return;
  sheet.getRange(1, 1, 1, sheet.getLastColumn()).setBackground('#1877F2').setFontColor('#FFFFFF').setFontWeight('bold');
  sheet.setFrozenRows(1);
}

